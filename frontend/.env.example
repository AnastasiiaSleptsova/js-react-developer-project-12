# Rollbar требует токен доступа для отслеживания ошибок
VITE_ROLLBAR_ACCESS_TOKEN=123
# `build-dev` / `build-prod` сами устанавливают `VITE_ROLLBAR_ENVIRONMENT`. Можно переопределить вручную.
VITE_ROLLBAR_ENVIRONMENT=development
# Опционально: если фронт и бэк на разных доменах/портах — укажите полный URL сокет-сервера
# VITE_SOCKET_URL=https://your-backend.example.com
